# Telegram Bot
TELEGRAM_BOT_TOKEN=         # From @BotFather on Telegram
TELEGRAM_OPERATOR_CHAT_ID=  # Your personal Telegram chat ID (number, not username)
                            # Get it by messaging @userinfobot

# n8n Webhook Integration
N8N_WEBHOOK_BASE_URL=       # e.g. https://your-n8n-instance.app.n8n.cloud
N8N_WEBHOOK_SECRET=         # Optional shared secret for webhook auth (set in n8n header auth)
